# Fragment konfiguracji nginx
charset utf-8;
gzip on; gzip_types text/css application/javascript application/json application/xml image/svg+xml;
location ~* \.(webp|png|jpg|woff2)$ { expires 1y; add_header Cache-Control "public, immutable"; }
location ~* \.(css|js)$ { expires 1M; }
error_page 404 /404.html;
